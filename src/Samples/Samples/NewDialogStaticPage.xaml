<Page x:Name="Root"
  x:Class="Elmish.Uno.Samples.NewDialogStatic.NewDialogStaticPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:samples="using:Elmish.Uno.Samples"
  xmlns:utoolkit="using:Uno.UI.Toolkit"
  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
  mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock HorizontalAlignment="Center" FontWeight="Bold">Dialog 1</TextBlock>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Command="{Binding Dialog1Show}" CommandParameter="ABC" Content="Show"  Width="70" Margin="5" />
      <Button Command="{Binding Dialog1Close}" Content="Close" Width="70" Margin="5" />
    </StackPanel>
    <TextBlock
      Grid.Row="2"
      Margin="0,10,0,0"
      HorizontalAlignment="Center"
      FontWeight="Bold"
      Text="Dialog 2" />
    <Button
      Grid.Row="3"
      Width="70"
      Margin="0,5,0,5"
      HorizontalAlignment="Center"
      Command="{Binding Dialog2Show}"
      Content="Show" />
    <TextBlock Grid.Row="4">
      <Run Text="Dialog 1 input:" />
      <Run Text="{Binding Dialog1.Input}" />
    </TextBlock>
    <TextBlock Grid.Row="5">
      <Run Text="Dialog 2 input:" />
      <Run Text="{Binding Dialog2.Input}" />
    </TextBlock>
    <TextBlock Grid.Row="6">
      <Run Text="Dialog 2 checkbox:" />
      <Run Text="{Binding Dialog2.IsChecked}" />
    </TextBlock>
  </Grid>
</Page>
